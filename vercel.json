{
  "crons": [
    { "path": "/api/followup-digest", "schedule": "30 3 * * *" },
    { "path": "/api/dashboard-summary", "schedule": "0 16 * * *" },
    { "path": "/api/finance", "schedule": "30 2 * * *" },
    { "path": "/api/tailortalk?action=sync", "schedule": "0 23 * * *" }
  ],
  "rewrites": [
    { "source": "/3pinfinance", "destination": "/3pinfinance.html" },
    { "source": "/api/generate-lead-summary", "destination": "/api/lead-summary?op=generate" },
    { "source": "/api/backfill-lead-summaries", "destination": "/api/lead-summary?op=backfill" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    }
  ]
}
